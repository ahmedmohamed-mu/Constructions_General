<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subcontract_profile_list" model="ir.ui.view">
        <field name="name">mu.construction.subcontract.profile.list</field>
        <field name="model">mu.construction.subcontract.profile</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="project_id"/><field name="contract_id"/><field name="effective_from"/><field name="effective_to"/><field name="retention_percent"/><field name="advance_recovery_percent"/><field name="reviewer_id"/><field name="approver_id"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list>
        </field>
    </record>
    <record id="view_subcontract_profile_form" model="ir.ui.view">
        <field name="name">mu.construction.subcontract.profile.form</field>
        <field name="model">mu.construction.subcontract.profile</field>
        <field name="arch" type="xml">
            <form><sheet><group><group><field name="name"/><field name="company_id"/><field name="project_id"/><field name="contract_id"/></group><group><field name="effective_from"/><field name="effective_to"/><field name="active"/></group></group><group string="Commercial Rules"><field name="retention_percent"/><field name="advance_recovery_percent"/><field name="allow_over_measurement"/></group><group string="Approval Responsibility"><field name="reviewer_id"/><field name="approver_id"/></group></sheet></form>
        </field>
    </record>
    <record id="action_subcontract_profiles" model="ir.actions.act_window"><field name="name">Subcontract Profiles</field><field name="res_model">mu.construction.subcontract.profile</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_subcontract_profiles" name="Subcontract Profiles" parent="mu_construction_core.menu_construction_configuration" action="action_subcontract_profiles" sequence="70" groups="mu_construction_core.group_construction_manager"/>
</odoo>
