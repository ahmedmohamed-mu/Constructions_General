<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_subcontract" model="ir.ui.view">
        <field name="name">purchase.order.form.construction.subcontract</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside"><button name="action_view_subcontract_measurements" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not is_construction_subcontract"><field name="subcontract_measurement_count" widget="statinfo" string="Measurements"/></button></xpath>
            <xpath expr="//sheet/notebook" position="inside"><page string="Subcontract" invisible="not project_id"><group><field name="is_construction_subcontract"/><field name="subcontract_scope" invisible="not is_construction_subcontract"/></group></page></xpath>
        </field>
    </record>
</odoo>
