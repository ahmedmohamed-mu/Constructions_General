<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_potential_change" model="ir.sequence"><field name="name">Potential Change Event</field><field name="code">mu.construction.potential.change</field><field name="prefix">PCE/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_contract_notice" model="ir.sequence"><field name="name">Contractual Notice</field><field name="code">mu.construction.notice</field><field name="prefix">NOT/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_variation" model="ir.sequence"><field name="name">Construction Variation</field><field name="code">mu.construction.variation</field><field name="prefix">VAR/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_claim" model="ir.sequence"><field name="name">Construction Claim</field><field name="code">mu.construction.claim</field><field name="prefix">CLM/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="cron_notice_deadline_alerts" model="ir.cron"><field name="name">Construction Notice Deadline Alerts</field><field name="model_id" ref="model_mu_construction_notice"/><field name="state">code</field><field name="code">model._cron_notice_deadline_alerts()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="active" eval="True"/></record>
    <record id="cron_claim_notice_alerts" model="ir.cron"><field name="name">Construction Claim Notice Alerts</field><field name="model_id" ref="model_mu_construction_claim"/><field name="state">code</field><field name="code">model._cron_claim_notice_alerts()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="active" eval="True"/></record>
</odoo>

