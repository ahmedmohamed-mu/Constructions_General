<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_profile_list" model="ir.ui.view"><field name="name">mu.construction.commercial.profile.list</field><field name="model">mu.construction.commercial.profile</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="project_id"/><field name="effective_from"/><field name="effective_to"/><field name="reviewer_id"/><field name="approver_id"/><field name="notice_alert_days"/><field name="active" widget="boolean_toggle"/></list></field></record>
    <record id="view_commercial_profile_form" model="ir.ui.view"><field name="name">mu.construction.commercial.profile.form</field><field name="model">mu.construction.commercial.profile</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="project_id"/><field name="effective_from"/><field name="effective_to"/><field name="active"/></group><group><field name="reviewer_id"/><field name="approver_id"/><field name="notice_alert_days"/></group></group></sheet></form></field></record>
    <record id="action_commercial_profiles" model="ir.actions.act_window"><field name="name">Variation &amp; Claim Profiles</field><field name="res_model">mu.construction.commercial.profile</field><field name="view_mode">list,form</field></record>

    <record id="view_potential_change_list" model="ir.ui.view"><field name="name">mu.construction.potential.change.list</field><field name="model">mu.construction.potential.change</field><field name="arch" type="xml"><list decoration-success="state == 'recognized'" decoration-muted="state in ('dismissed','cancelled')"><field name="name"/><field name="title"/><field name="source"/><field name="project_id"/><field name="contract_id"/><field name="occurrence_date"/><field name="notice_deadline"/><field name="preliminary_cost"/><field name="preliminary_days"/><field name="state" widget="badge"/><field name="next_responsible_id" optional="show"/></list></field></record>
    <record id="view_potential_change_form" model="ir.ui.view"><field name="name">mu.construction.potential.change.form</field><field name="model">mu.construction.potential.change</field><field name="arch" type="xml"><form><header><button name="action_submit_assessment" string="Submit Assessment" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_recognize" string="Recognize" type="object" class="btn-primary" invisible="state != 'assessment'"/><button name="action_dismiss" string="Dismiss" type="object" invisible="state != 'assessment'"/><button name="action_create_variation" string="Create Variation" type="object" class="btn-primary" invisible="state != 'recognized'"/><button name="action_create_claim" string="Create Claim/EOT" type="object" class="btn-primary" invisible="state != 'recognized'"/><field name="state" widget="statusbar" statusbar_visible="draft,assessment,recognized,dismissed"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="title"/></h2></div><group><group><field name="project_id"/><field name="contract_id"/><field name="source"/><field name="instruction_reference"/><field name="occurrence_date"/><field name="notice_deadline"/></group><group><field name="rfi_id"/><field name="drawing_id"/><field name="boq_id"/><field name="wbs_id"/><field name="location_id"/><field name="preliminary_cost"/><field name="preliminary_days"/></group></group><notebook><page string="Scope"><field name="scope"/></page><page string="Responsibility"><group><field name="creator_id"/><field name="profile_id"/><field name="reviewer_id"/><field name="approver_id"/><field name="next_responsible_id"/></group></page><page string="Records"><field name="document_ids"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_potential_changes" model="ir.actions.act_window"><field name="name">Potential Changes</field><field name="res_model">mu.construction.potential.change</field><field name="view_mode">list,form</field></record>

    <record id="view_notice_list" model="ir.ui.view"><field name="name">mu.construction.notice.list</field><field name="model">mu.construction.notice</field><field name="arch" type="xml"><list decoration-danger="state not in ('issued','acknowledged','cancelled') and deadline &lt; context_today()" decoration-success="state in ('issued','acknowledged')"><field name="name"/><field name="subject"/><field name="notice_type"/><field name="project_id"/><field name="contract_id"/><field name="deadline"/><field name="notice_date"/><field name="reference"/><field name="recipient_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_notice_form" model="ir.ui.view"><field name="name">mu.construction.notice.form</field><field name="model">mu.construction.notice</field><field name="arch" type="xml"><form><header><button name="action_submit_review" string="Submit Review" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_mark_reviewed" string="Reviewed" type="object" class="btn-primary" invisible="state != 'review'"/><button name="action_issue" string="Issue Notice" type="object" class="btn-primary" invisible="state != 'reviewed'"/><button name="action_acknowledge" string="Acknowledge" type="object" class="btn-primary" invisible="state != 'issued'"/><field name="state" widget="statusbar" statusbar_visible="draft,review,reviewed,issued,acknowledged"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="subject"/></h2></div><group><group><field name="project_id"/><field name="contract_id"/><field name="notice_type"/><field name="recipient_id"/><field name="deadline"/></group><group><field name="notice_date"/><field name="reference"/><field name="acknowledged_date"/><field name="potential_change_id"/><field name="variation_id"/><field name="claim_id"/></group></group><notebook><page string="Notice"><field name="body"/></page><page string="Records"><field name="document_ids"/></page><page string="Responsibility"><group><field name="profile_id"/><field name="reviewer_id"/><field name="approver_id"/><field name="next_responsible_id"/></group></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_notices" model="ir.actions.act_window"><field name="name">Contractual Notices</field><field name="res_model">mu.construction.notice</field><field name="view_mode">list,form</field></record>

    <record id="view_variation_list" model="ir.ui.view"><field name="name">mu.construction.variation.list</field><field name="model">mu.construction.variation</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-muted="state in ('rejected','cancelled')"><field name="name"/><field name="title"/><field name="project_id"/><field name="contract_id"/><field name="selling_value"/><field name="submitted_value"/><field name="negotiated_value"/><field name="approved_value"/><field name="extension_requested_days"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_variation_form" model="ir.ui.view"><field name="name">mu.construction.variation.form</field><field name="model">mu.construction.variation</field><field name="arch" type="xml"><form><header><button name="action_submit_technical" string="Technical Assessment" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_internal_approve" string="Internal Approval" type="object" class="btn-primary" invisible="state != 'technical'"/><button name="action_submit_client" string="Submit to Client" type="object" class="btn-primary" invisible="state != 'internal_review'"/><button name="action_start_negotiation" string="Start Negotiation" type="object" invisible="state != 'submitted'"/><button name="action_approve_client" string="Record Approval" type="object" class="btn-primary" invisible="state not in ('submitted','negotiation')"/><button name="action_reject_client" string="Record Rejection" type="object" invisible="state not in ('submitted','negotiation')"/><button name="action_prepare_budget_amendment" string="Prepare Budget Amendment" type="object" invisible="state != 'approved' or budget_amendment_id"/><field name="state" widget="statusbar" statusbar_visible="draft,technical,internal_review,submitted,negotiation,approved"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="title"/></h2></div><group><group><field name="project_id"/><field name="contract_id"/><field name="potential_change_id"/><field name="origin"/><field name="instruction_reference"/><field name="notice_deadline"/><field name="notice_date"/><field name="notice_reference"/><field name="notice_waiver_reason"/></group><group><field name="schedule_impact_days"/><field name="extension_requested_days"/><field name="selling_value"/><field name="submitted_value"/><field name="negotiated_value"/><field name="approved_value"/><field name="client_approval_reference"/><field name="approval_date"/><field name="budget_amendment_id"/></group></group><notebook><page string="Scope"><field name="scope"/></page><page string="Estimate"><field name="line_ids" readonly="state in ('approved','rejected')"><list editable="bottom"><field name="sequence" widget="handle"/><field name="description"/><field name="boq_line_id"/><field name="wbs_id"/><field name="cost_code_id"/><field name="location_id"/><field name="quantity"/><field name="product_uom_id"/><field name="material_cost"/><field name="labor_cost"/><field name="equipment_cost"/><field name="subcontract_cost"/><field name="site_overhead"/><field name="time_related_cost"/><field name="markup_percent"/><field name="total_cost"/><field name="selling_value"/></list></field><group><field name="material_cost"/><field name="labor_cost"/><field name="equipment_cost"/><field name="subcontract_cost"/><field name="site_overhead"/><field name="time_related_cost"/><field name="total_cost"/><field name="selling_value"/></group></page><page string="Records"><field name="document_ids"/></page><page string="Responsibility"><group><field name="profile_id"/><field name="reviewer_id"/><field name="approver_id"/><field name="next_responsible_id"/></group></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_variations" model="ir.actions.act_window"><field name="name">Variations</field><field name="res_model">mu.construction.variation</field><field name="view_mode">list,form</field></record>

    <record id="view_claim_list" model="ir.ui.view"><field name="name">mu.construction.claim.list</field><field name="model">mu.construction.claim</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-danger="not notice_date and notice_deadline &lt; context_today()"><field name="name"/><field name="title"/><field name="claim_type"/><field name="project_id"/><field name="contract_id"/><field name="notice_deadline"/><field name="submitted_days"/><field name="approved_days"/><field name="submitted_amount"/><field name="approved_amount"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_claim_form" model="ir.ui.view"><field name="name">mu.construction.claim.form</field><field name="model">mu.construction.claim</field><field name="arch" type="xml"><form><header><button name="action_prepare_notice" string="Prepare Notice" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_start_assessment" string="Start Assessment" type="object" class="btn-primary" invisible="state != 'notice'"/><button name="action_internal_approve" string="Internal Approval" type="object" class="btn-primary" invisible="state != 'assessment'"/><button name="action_submit_client" string="Submit to Client" type="object" class="btn-primary" invisible="state != 'internal_review'"/><button name="action_start_negotiation" string="Start Negotiation" type="object" invisible="state != 'submitted'"/><button name="action_approve_client" string="Record Approval" type="object" class="btn-primary" invisible="state not in ('submitted','negotiation')"/><button name="action_reject_client" string="Record Rejection" type="object" invisible="state not in ('submitted','negotiation')"/><field name="state" widget="statusbar" statusbar_visible="draft,notice,assessment,internal_review,submitted,negotiation,approved"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="title"/></h2></div><group><group><field name="project_id"/><field name="contract_id"/><field name="claim_type"/><field name="potential_change_id"/><field name="variation_id"/><field name="contract_clause"/><field name="notice_deadline"/><field name="notice_date"/><field name="notice_reference"/></group><group><field name="critical_path_impact_days"/><field name="submitted_days"/><field name="approved_days"/><field name="submitted_amount"/><field name="approved_amount"/><field name="client_decision_reference"/><field name="decision_date"/></group></group><notebook><page string="Cause Event"><field name="cause_event"/></page><page string="Schedule"><field name="affected_task_ids" widget="many2many_tags"/><field name="baseline_schedule_reference"/><field name="updated_schedule_reference"/><field name="delay_analysis"/></page><page string="Contemporary Records"><field name="document_ids"/></page><page string="Responsibility"><group><field name="profile_id"/><field name="reviewer_id"/><field name="approver_id"/><field name="next_responsible_id"/></group></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_claims" model="ir.actions.act_window"><field name="name">Claims &amp; EOT</field><field name="res_model">mu.construction.claim</field><field name="view_mode">list,form</field></record>

    <menuitem id="menu_commercial_profiles" name="Variation &amp; Claim Profiles" parent="mu_construction_core.menu_construction_configuration" action="action_commercial_profiles" sequence="90" groups="mu_construction_core.group_construction_manager"/>
    <menuitem id="menu_changes_claims" name="Variations, Claims &amp; EOT"
              parent="mu_construction_contract_boq.menu_construction_operations" sequence="100"
              groups="mu_construction_core.group_construction_user"/>
    <menuitem id="menu_potential_changes" name="Potential Changes" parent="menu_changes_claims" action="action_potential_changes" sequence="10" groups="mu_construction_core.group_construction_user"/>
    <menuitem id="menu_contract_notices" name="Contractual Notices" parent="menu_changes_claims" action="action_notices" sequence="20" groups="mu_construction_core.group_construction_user"/>
    <menuitem id="menu_variations" name="Variations" parent="menu_changes_claims" action="action_variations" sequence="30" groups="mu_construction_core.group_construction_user"/>
    <menuitem id="menu_claims" name="Claims &amp; EOT" parent="menu_changes_claims" action="action_claims" sequence="40" groups="mu_construction_core.group_construction_user"/>
</odoo>
