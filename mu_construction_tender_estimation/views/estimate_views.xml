<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_estimate_list" model="ir.ui.view"><field name="name">mu.construction.estimate.list</field><field name="model">mu.construction.estimate</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-muted="state == 'superseded'"><field name="tender_id"/><field name="revision"/><field name="name"/><field name="direct_cost"/><field name="selling_price"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_construction_estimate_form" model="ir.ui.view"><field name="name">mu.construction.estimate.form</field><field name="model">mu.construction.estimate</field><field name="arch" type="xml"><form>
        <header><button name="action_submit_review" string="Submit for Review" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_mark_reviewed" string="Mark Reviewed" type="object" class="btn-primary" invisible="state != 'review'"/><button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'reviewed'"/><button name="action_new_revision" string="New Revision" type="object" invisible="state != 'approved'"/><button name="action_generate_boqs" string="Generate Cost and Selling BOQs" type="object" invisible="state != 'approved' or generated_cost_boq_id"/><field name="state" widget="statusbar" statusbar_visible="draft,review,reviewed,approved"/></header>
        <sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="tender_id"/><field name="revision"/><field name="profile_id"/><field name="project_id"/></group><group><field name="reviewer_id"/><field name="approver_id"/><field name="generated_cost_boq_id"/><field name="generated_sell_boq_id"/></group></group>
        <notebook><page string="Resource Analysis"><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="code"/><field name="resource_type"/><field name="name"/><field name="product_id" optional="hide"/><field name="product_uom_id"/><field name="quantity"/><field name="waste_percent"/><field name="effective_quantity"/><field name="unit_cost"/><field name="amount" sum="Direct Cost"/><field name="currency_id" column_invisible="True"/><field name="wbs_id" optional="show"/><field name="cost_code_id" optional="show"/><field name="location_id" optional="show"/><field name="project_id" column_invisible="True"/></list></field></page></notebook>
        <group string="Totals" class="oe_subtotal_footer"><field name="currency_id" invisible="1"/><field name="direct_cost"/><field name="overhead_amount"/><field name="contingency_amount"/><field name="markup_amount"/><field name="selling_price" class="oe_subtotal_footer_separator"/><field name="company_id" invisible="1"/></group>
        </sheet><chatter/></form></field></record>
    <record id="view_estimate_profile_list" model="ir.ui.view"><field name="name">mu.construction.estimate.profile.list</field><field name="model">mu.construction.estimate.profile</field><field name="arch" type="xml"><list><field name="name"/><field name="project_id"/><field name="effective_from"/><field name="effective_to"/><field name="default_waste_percent"/><field name="overhead_percent"/><field name="contingency_percent"/><field name="markup_percent"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_estimate_profile_form" model="ir.ui.view"><field name="name">mu.construction.estimate.profile.form</field><field name="model">mu.construction.estimate.profile</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="company_id"/><field name="project_id"/><field name="active"/></group><group><field name="effective_from"/><field name="effective_to"/></group></group><group string="Configurable Percentages"><field name="default_waste_percent"/><field name="overhead_percent"/><field name="contingency_percent"/><field name="markup_percent"/></group></sheet></form></field></record>
    <record id="action_construction_estimates" model="ir.actions.act_window"><field name="name">Construction Estimates</field><field name="res_model">mu.construction.estimate</field><field name="view_mode">list,form</field></record>
    <record id="action_estimate_profiles" model="ir.actions.act_window"><field name="name">Estimation Profiles</field><field name="res_model">mu.construction.estimate.profile</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_construction_estimates" name="Estimates" parent="mu_construction_contract_boq.menu_construction_operations" action="action_construction_estimates" sequence="7"/>
    <menuitem id="menu_estimate_profiles" name="Estimation Profiles" parent="mu_construction_core.menu_construction_configuration" action="action_estimate_profiles" sequence="60"/>
</odoo>
