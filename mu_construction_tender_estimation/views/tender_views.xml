<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_tender_list" model="ir.ui.view"><field name="name">mu.construction.tender.list</field><field name="model">mu.construction.tender</field><field name="arch" type="xml"><list decoration-success="state == 'won'" decoration-danger="state == 'lost'"><field name="name"/><field name="title"/><field name="partner_id"/><field name="project_id"/><field name="submission_date"/><field name="owner_id"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_construction_tender_form" model="ir.ui.view"><field name="name">mu.construction.tender.form</field><field name="model">mu.construction.tender</field><field name="arch" type="xml"><form>
        <header><button name="action_start_estimation" string="Start Estimation" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_submit_review" string="Submit for Review" type="object" class="btn-primary" invisible="state != 'estimating'"/><button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'review'"/><button name="action_submit" string="Mark Submitted" type="object" invisible="state != 'approved'"/><button name="action_mark_won" string="Won" type="object" invisible="state != 'submitted'"/><button name="action_mark_lost" string="Lost" type="object" invisible="state != 'submitted'"/><button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'estimating', 'review')"/><field name="state" widget="statusbar" statusbar_visible="draft,estimating,review,approved,submitted,won"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button name="action_view_estimates" type="object" class="oe_stat_button" icon="fa-calculator"><field name="estimate_count" widget="statinfo" string="Estimates"/></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="title"/></h2></div>
        <group><group><field name="partner_id"/><field name="opportunity_id"/><field name="project_id"/><field name="analytic_account_id"/></group><group><field name="submission_date"/><field name="currency_id"/><field name="bid_bond_required"/><field name="bid_bond_amount" invisible="not bid_bond_required"/></group></group>
        <group string="Responsibility"><field name="owner_id"/><field name="reviewer_id"/><field name="approver_id"/><field name="next_responsible_id"/></group><notebook><page string="Notes"><field name="notes"/></page></notebook><field name="company_id" invisible="1"/>
        </sheet><chatter/></form></field></record>
    <record id="action_construction_tenders" model="ir.actions.act_window"><field name="name">Construction Tenders</field><field name="res_model">mu.construction.tender</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_construction_tenders" name="Tenders" parent="mu_construction_contract_boq.menu_construction_operations" action="action_construction_tenders" sequence="5"/>
</odoo>
