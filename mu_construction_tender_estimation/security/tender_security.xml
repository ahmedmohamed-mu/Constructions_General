<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tender_company_rule" model="ir.rule"><field name="name">Construction tenders: allowed companies</field><field name="model_id" ref="model_mu_construction_tender"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('mu_construction_core.group_tender_user'))]"/></record>
    <record id="estimate_company_rule" model="ir.rule"><field name="name">Construction estimates: allowed companies</field><field name="model_id" ref="model_mu_construction_estimate"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('mu_construction_core.group_tender_user'))]"/></record>
    <record id="estimate_line_company_rule" model="ir.rule"><field name="name">Construction estimate lines: allowed companies</field><field name="model_id" ref="model_mu_construction_estimate_line"/><field name="domain_force">[('estimate_id.company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('mu_construction_core.group_tender_user'))]"/></record>
    <record id="estimate_profile_company_rule" model="ir.rule"><field name="name">Construction estimate profiles: allowed companies</field><field name="model_id" ref="model_mu_construction_estimate_profile"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('mu_construction_core.group_tender_user'))]"/></record>
</odoo>
