<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_deduction_rule_list" model="ir.ui.view">
        <field name="name">mu.construction.deduction.rule.list</field>
        <field name="model">mu.construction.deduction.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="calculation_basis"/>
                <field name="percent"/>
                <field name="fixed_amount"/>
                <field name="cap_amount"/>
                <field name="account_id"/>
                <field name="tax_effect"/>
                <field name="start_certificate_number" optional="hide"/>
                <field name="end_condition" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_contract_term_form_commercial" model="ir.ui.view">
        <field name="name">mu.construction.contract.term.form.commercial</field>
        <field name="model">mu.construction.contract.term</field>
        <field name="inherit_id" ref="mu_construction_contract_boq.view_contract_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="" position="after">
                <field name="currency_id" invisible="1"/>
                <group string="Retention and Advance">
                    <field name="retention_cap_percent"/>
                    <field name="advance_recovery_method"/>
                    <field name="advance_recovery_start_percent"/>
                    <field name="materials_on_site_percent"/>
                </group>
                <group string="Certification and Payment">
                    <field name="minimum_certificate_value"/>
                    <field name="payment_cycle_days"/>
                    <field name="certification_period_days"/>
                    <field name="payment_due_days"/>
                </group>
                <group string="Delay, Defects and Notices">
                    <field name="ld_rate_percent"/>
                    <field name="ld_cap_percent"/>
                    <field name="dlp_months"/>
                    <field name="claim_notice_days"/>
                    <field name="variation_notice_days"/>
                </group>
                <group string="Price Adjustment">
                    <field name="price_adjustment_formula" nolabel="1"/>
                </group>
                <notebook>
                    <page string="Deduction Rules">
                        <field name="deduction_rule_ids" context="{'default_term_id': id}"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_guarantee_list" model="ir.ui.view">
        <field name="name">mu.construction.guarantee.list</field>
        <field name="model">mu.construction.guarantee</field>
        <field name="arch" type="xml">
            <list decoration-danger="days_to_expiry &lt; 0" decoration-warning="days_to_expiry &gt;= 0 and days_to_expiry &lt;= notice_days" decoration-muted="state in ('released', 'expired')">
                <field name="reference"/>
                <field name="guarantee_type"/>
                <field name="contract_id"/>
                <field name="project_id" optional="show"/>
                <field name="beneficiary_id"/>
                <field name="issuing_bank_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="notice_days" column_invisible="True"/>
                <field name="days_to_expiry" string="Days Left"/>
                <field name="responsible_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_guarantee_form" model="ir.ui.view">
        <field name="name">mu.construction.guarantee.form</field>
        <field name="model">mu.construction.guarantee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state not in ('draft', 'extended')"/>
                    <button name="action_extend" string="Mark Extended" type="object" invisible="state not in ('active', 'extended')"/>
                    <button name="action_release" string="Release" type="object" invisible="state not in ('active', 'extended', 'expired')"/>
                    <button name="action_mark_called" string="Mark Called" type="object" invisible="state not in ('active', 'extended')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,released"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1><field name="reference" placeholder="Bank reference"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="guarantee_type"/>
                            <field name="contract_id"/>
                            <field name="project_id"/>
                            <field name="beneficiary_id"/>
                            <field name="issuing_bank_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="commission_amount"/>
                            <field name="collateral_amount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Validity and Renewal">
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="notice_days"/>
                            <field name="renewal_deadline"/>
                            <field name="days_to_expiry"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_guarantee_search" model="ir.ui.view">
        <field name="name">mu.construction.guarantee.search</field>
        <field name="model">mu.construction.guarantee</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <field name="beneficiary_id"/>
                <filter name="filter_live" string="Live" domain="[('state', 'in', ('active', 'extended'))]"/>
                <filter name="filter_due_renewal" string="Due for Renewal" domain="[('state', 'in', ('active', 'extended')), ('renewal_deadline', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'guarantee_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_insurance_list" model="ir.ui.view">
        <field name="name">mu.construction.insurance.list</field>
        <field name="model">mu.construction.insurance</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired', 'cancelled')">
                <field name="name"/>
                <field name="policy_type"/>
                <field name="contract_id"/>
                <field name="project_id" optional="show"/>
                <field name="insurer_id"/>
                <field name="coverage_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="start_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="responsible_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_form" model="ir.ui.view">
        <field name="name">mu.construction.insurance.form</field>
        <field name="model">mu.construction.insurance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'active')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Policy number"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_type"/>
                            <field name="contract_id"/>
                            <field name="project_id"/>
                            <field name="insurer_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="coverage_amount"/>
                            <field name="deductible_amount"/>
                            <field name="premium_amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Validity and Renewal">
                        <group>
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="notice_days"/>
                            <field name="renewal_deadline"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_contract_form_commercial" model="ir.ui.view">
        <field name="name">mu.construction.contract.form.commercial</field>
        <field name="model">mu.construction.contract</field>
        <field name="inherit_id" ref="mu_construction_contract_boq.view_construction_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_guarantees" type="object" class="oe_stat_button" icon="fa-shield">
                    <field name="guarantee_count" widget="statinfo" string="Guarantees"/>
                </button>
                <button name="action_view_insurances" type="object" class="oe_stat_button" icon="fa-umbrella">
                    <field name="insurance_count" widget="statinfo" string="Insurance"/>
                </button>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="before">
                <widget name="web_ribbon" title="Guarantee Renewal Due" bg_color="text-bg-danger" invisible="expiring_guarantee_count == 0"/>
            </xpath>
        </field>
    </record>

    <record id="action_construction_guarantees" model="ir.actions.act_window">
        <field name="name">Guarantees and Bonds</field>
        <field name="res_model">mu.construction.guarantee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_live': 1}</field>
    </record>

    <record id="action_construction_insurances" model="ir.actions.act_window">
        <field name="name">Insurance Policies</field>
        <field name="res_model">mu.construction.insurance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_construction_guarantees" name="Guarantees and Bonds"
              parent="mu_construction_contract_boq.menu_construction_operations"
              action="action_construction_guarantees" sequence="30"/>
    <menuitem id="menu_construction_insurances" name="Insurance Policies"
              parent="mu_construction_contract_boq.menu_construction_operations"
              action="action_construction_insurances" sequence="40"/>

</odoo>
