<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="site_execution_profile_company_rule" model="ir.rule">
        <field name="name">Site execution profiles: allowed companies</field>
        <field name="model_id" ref="model_mu_construction_site_execution_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('mu_construction_core.group_site_user'))]"/>
    </record>
