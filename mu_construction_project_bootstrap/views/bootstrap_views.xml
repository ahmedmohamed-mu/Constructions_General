<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_bootstrap_list" model="ir.ui.view"><field name="name">mu.construction.project.bootstrap.list</field><field name="model">mu.construction.project.bootstrap</field><field name="arch" type="xml"><list decoration-success="state == 'done'"><field name="name"/><field name="tender_id"/><field name="project_id"/><field name="accepted_estimate_id"/><field name="contract_id"/><field name="manager_id"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_project_bootstrap_form" model="ir.ui.view"><field name="name">mu.construction.project.bootstrap.form</field><field name="model">mu.construction.project.bootstrap</field><field name="arch" type="xml"><form>
        <header><button name="action_submit_review" string="Submit for Review" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'review'"/><button name="action_execute" string="Execute Bootstrap" type="object" class="btn-primary" invisible="state != 'approved'"/><button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'review')"/><field name="state" widget="statusbar" statusbar_visible="draft,review,approved,done"/></header>
        <sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="tender_id"/><field name="project_id"/><field name="analytic_account_id"/><field name="accepted_estimate_id"/></group><group><field name="contract_type_id"/><field name="term_id"/><field name="contract_start_date"/><field name="contract_end_date"/></group></group>
        <group string="Responsibility"><field name="manager_id"/><field name="reviewer_id"/><field name="approver_id"/><field name="checklist_complete"/></group><group string="Generated Standard Records"><field name="contract_id"/><field name="cost_boq_id"/><field name="sell_boq_id"/></group><notebook><page string="Handover Notes"><field name="notes"/></page></notebook><field name="company_id" invisible="1"/><field name="currency_id" invisible="1"/></sheet><chatter/></form></field></record>
    <record id="action_project_bootstraps" model="ir.actions.act_window"><field name="name">Project Bootstraps</field><field name="res_model">mu.construction.project.bootstrap</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_project_setup" name="Project Setup"
              sequence="30" web_icon="mu_construction_core,static/description/icon.svg"
              groups="mu_construction_core.group_bootstrap_user"/>
    <menuitem id="menu_project_bootstraps" name="Project Bootstrap" parent="menu_project_setup" action="action_project_bootstraps" sequence="10"/>
</odoo>
