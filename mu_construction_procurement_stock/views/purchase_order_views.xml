<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="view_purchase_order_form_construction" model="ir.ui.view"><field name="name">purchase.order.form.construction</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml">
    <xpath expr="//header" position="inside"><button name="action_construction_submit_review" string="Construction Review" type="object" class="btn-primary" invisible="not project_id or construction_approval_state not in ('draft', 'rejected') or state not in ('draft', 'sent')"/><button name="action_construction_mark_reviewed" string="Mark Construction Reviewed" type="object" class="btn-primary" invisible="construction_approval_state != 'review'"/><button name="action_construction_approve" string="Approve Construction PO" type="object" class="btn-primary" invisible="construction_approval_state != 'reviewed'"/><button name="action_construction_reject" string="Reject Construction Approval" type="object" invisible="construction_approval_state not in ('review', 'reviewed')"/></xpath>
    <xpath expr="//sheet/notebook" position="inside"><page string="Construction Context" invisible="not project_id"><group><group><field name="project_id"/><field name="construction_contract_id"/><field name="construction_boq_id"/><field name="analytic_account_id"/></group><group><field name="procurement_profile_id"/><field name="construction_approval_state" widget="badge"/><field name="construction_reviewer_id"/><field name="construction_approver_id"/><field name="construction_next_responsible_id"/><field name="construction_context_complete"/></group></group><field name="order_line"><list editable="bottom"><field name="sequence" widget="handle"/><field name="product_id"/><field name="name"/><field name="product_qty"/><field name="product_uom_id"/><field name="price_unit"/><field name="construction_boq_line_id"/><field name="construction_wbs_id"/><field name="construction_cost_code_id"/><field name="construction_location_id"/><field name="project_id" column_invisible="True"/><field name="construction_boq_id" column_invisible="True"/></list></field></page></xpath>
</field></record></odoo>
