<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_profile_list" model="ir.ui.view"><field name="name">mu.construction.procurement.profile.list</field><field name="model">mu.construction.procurement.profile</field><field name="arch" type="xml"><list><field name="name"/><field name="project_id"/><field name="effective_from"/><field name="effective_to"/><field name="minimum_amount"/><field name="maximum_amount"/><field name="currency_id" column_invisible="True"/><field name="reviewer_id"/><field name="approver_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_procurement_profile_form" model="ir.ui.view"><field name="name">mu.construction.procurement.profile.form</field><field name="model">mu.construction.procurement.profile</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="company_id"/><field name="project_id"/><field name="active"/></group><group><field name="effective_from"/><field name="effective_to"/><field name="minimum_amount"/><field name="maximum_amount"/><field name="currency_id" invisible="1"/></group></group><group string="Approval"><field name="reviewer_id"/><field name="approver_id"/></group><group string="Required Purchase Line Context"><field name="require_boq_line"/><field name="require_wbs"/><field name="require_cost_code"/><field name="require_location"/></group></sheet></form></field></record>
    <record id="action_procurement_profiles" model="ir.actions.act_window"><field name="name">Procurement Approval Profiles</field><field name="res_model">mu.construction.procurement.profile</field><field name="view_mode">list,form</field></record>
    <record id="action_construction_purchase_orders" model="ir.actions.act_window">
        <field name="name">Construction Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('project_id', '!=', False)]</field>
    </record>
    <record id="action_construction_receipts" model="ir.actions.act_window">
        <field name="name">Construction Receipts &amp; Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('construction_project_id', '!=', False)]</field>
    </record>
    <menuitem id="menu_construction_procurement" name="Procurement &amp; Inventory"
              sequence="40" web_icon="mu_construction_core,static/description/icon.svg"
              groups="mu_construction_core.group_procurement_user"/>
    <menuitem id="menu_construction_purchase_orders" name="Purchase Orders"
              parent="menu_construction_procurement" action="action_construction_purchase_orders"
              sequence="10" groups="purchase.group_purchase_user"/>
    <menuitem id="menu_construction_receipts" name="Receipts &amp; Transfers"
              parent="menu_construction_procurement" action="action_construction_receipts"
              sequence="20" groups="stock.group_stock_user"/>
    <menuitem id="menu_procurement_profiles" name="Approval Profiles" parent="menu_construction_procurement" action="action_procurement_profiles" sequence="90" groups="mu_construction_core.group_procurement_manager"/>
</odoo>
