<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_construction" model="ir.ui.view">
        <field name="name">project.project.form.construction</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_construction_locations" type="object" class="oe_stat_button"
                        icon="fa-map-marker" groups="mu_construction_core.group_construction_user">
                    <field name="construction_location_count" widget="statinfo" string="Locations"/>
                </button>
                <button name="action_view_construction_cost_codes" type="object" class="oe_stat_button"
                        icon="fa-tags" groups="mu_construction_core.group_construction_user">
                    <field name="construction_cost_code_count" widget="statinfo" string="Cost Codes"/>
                </button>
                <button name="action_view_construction_wbs" type="object" class="oe_stat_button"
                        icon="fa-sitemap" groups="mu_construction_core.group_construction_user">
                    <field name="construction_wbs_count" widget="statinfo" string="WBS"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="construction_reference" placeholder="Construction project code"/>
            </xpath>
        </field>
    </record>
</odoo>
